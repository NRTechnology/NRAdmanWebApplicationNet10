@{
  Layout = "_CommonMasterLayout";
  ViewData["navbarType"] = (ViewData["navbarType"] ?? "layout-navbar-fixed");
  ViewData["isFront"] = (ViewData["isFront"] ??= true);
}

@section VendorStyles { @await RenderSectionAsync("VendorStyles", required: false) }

@section PageStyles { @await RenderSectionAsync("PageStyles", required: false) }


<!-- Navbar -->
@await Html.PartialAsync("Sections/Navbar/_NavbarFront")
<!-- / Navbar -->

@RenderBody()

<!-- Footer -->
@await Html.PartialAsync("Sections/Footer/_FooterFront")
<!-- / Footer -->

@section VendorScripts { @await RenderSectionAsync("VendorScripts", required: false) }

@section PageScripts { @await RenderSectionAsync("PageScripts", required: false) }
