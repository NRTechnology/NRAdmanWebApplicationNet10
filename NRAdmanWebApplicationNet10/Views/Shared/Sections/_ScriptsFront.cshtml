<environment include="Development">
  <script src="~/assets/vendor/libs/popper/popper.js"></script>
  <script src="~/assets/vendor/js/bootstrap.js"></script>
  <!-- node-waves required for animation on button click -->
  <script src="~/assets/vendor/libs/node-waves/node-waves.js"></script>
  <script src="~/assets/vendor/libs/pickr/pickr.js"></script>
  <script src="~/assets/js/site.js"></script>
</environment>
<environment exclude="Development">
  <script src="~/assets/vendor/libs/popper/popper.js" asp-append-version="true"></script>
  <script src="~/assets/vendor/js/bootstrap.js" asp-append-version="true"></script>
  <script src="~/assets/vendor/libs/node-waves/node-waves.js" asp-append-version="true"></script>
  <script src="~/assets/vendor/libs/pickr/pickr.js" asp-append-version="true"></script>
  <script src="~/assets/js/site.js" asp-append-version="true"></script>
</environment>
