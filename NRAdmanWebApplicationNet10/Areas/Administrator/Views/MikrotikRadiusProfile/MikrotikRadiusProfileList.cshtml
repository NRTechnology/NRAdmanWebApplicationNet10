@{
    ViewData["Title"] = "Mikrotik RADIUS Policy Management";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
}

@section VendorScripts {
    <script src="~/assets/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
    <script src="~/assets/vendor/libs/jquery-validate/jquery.validate.min.js"></script>
    <script src="~/assets/vendor/libs/jquery-validate/additional-methods.min.js"></script>
    <script src="~/assets/vendor/libs/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}

@section PageScripts {
    <script>
        var dataTable;

        document.addEventListener('DOMContentLoaded', function() {
            dataTable = new DataTable(document.querySelector('#datatable'), {
                ajax: {
                    url: '@Url.Action("GetJsonResult", "MikrotikRadiusProfile", new { area = "Administrator" })',
                    dataSrc: ''
                },
                layout: {
                    topStart: {
                        rowClass: 'row mx-3 my-0 justify-content-between',
                        features: [
                            {
                                pageLength: {
                                    menu: [7, 10, 25, 50, 100],
                                    text: 'Show_MENU_entries'
                                }
                            }
                        ]
                    },
                    topEnd: {
                        search: {
                            placeholder: 'Search policies...'
                        }
                    },
                    bottomStart: {
                        rowClass: 'row mx-3 justify-content-between',
                        features: ['info']
                    },
                    bottomEnd: 'paging'
                },
                language: {
                    paginate: {
                        next: '<i class="icon-base ti tabler-chevron-right scaleX-n1-rtl icon-18px"></i>',
                        previous: '<i class="icon-base ti tabler-chevron-left scaleX-n1-rtl icon-18px"></i>',
                        first: '<i class="icon-base ti tabler-chevrons-left scaleX-n1-rtl icon-18px"></i>',
                        last: '<i class="icon-base ti tabler-chevrons-right scaleX-n1-rtl icon-18px"></i>'
                    }
                },
                columns: [
                    { data: 'id', title: 'ID' },
                    { data: 'policyName', title: 'Policy Name' },
                    { data: 'description', title: 'Description' },
                    { data: 'downloadLimit', title: 'Download Limit' },
                    { data: 'uploadLimit', title: 'Upload Limit' },
                    { data: 'queueType', title: 'Queue Type' },
                    { data: 'priority', title: 'Priority' },
                    { data: 'isActive', title: 'Status' },
                    {
                        data: 'id', title: 'Actions', orderable: false, render: function(data, type, row) {
                            return `<button class="btn btn-sm btn-primary btn-edit-policy" data-id="${data}" style="margin-right: 5px;">Edit</button>
                                    <button class="btn btn-sm btn-danger btn-delete-policy" data-id="${data}">Delete</button>`;
                        }
                    }
                ],
                responsive: true
            });

            window.dataTable = dataTable;

            // Handle Add New button click
            $(document).on('click', '#btn-add-policy', function() {
                window.location.href = '@Url.Action("Create", "MikrotikRadiusProfile", new { area = "Administrator" })';
            });

            // Handle Edit button click
            $(document).on('click', '.btn-edit-policy', function() {
                var policyId = $(this).data('id');
                window.location.href = '@Url.Action("Edit", "MikrotikRadiusProfile", new { area = "Administrator" })?id=' + policyId;
            });

            // Handle Delete button click
            $(document).on('click', '.btn-delete-policy', function() {
                var policyId = $(this).data('id');
                if (confirm('Are you sure you want to delete this policy?')) {
                    $.post('@Url.Action("Delete", "MikrotikRadiusProfile", new { area = "Administrator" })', { id: policyId }, function(response) {
                        if (response.success) {
                            // Reload the DataTable
                            dataTable.ajax.reload();
                            alert(response.message);
                        } else {
                            alert('Error: ' + response.message);
                        }
                    });
                }
            });
        });
    </script>
}

<div class="container-xl">
    <!-- Page title -->
    <div class="page-header d-print-none">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title">
                    Mikrotik RADIUS Policy Management
                </h2>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <div class="btn-list">
                    <button id="btn-add-policy" class="btn btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M12 5l0 14m-7 -7l14 0" />
                        </svg>
                        Create New Policy
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-wrapper">
    <!-- Page body -->
    <div class="page-body">
        <div class="container-xl">
            <div class="row row-deck row-cards">
                <div class="col-12">
                    <div class="card">
                        <div class="table-responsive">
                            <table id="datatable" class="table table-vcenter card-table"></table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
