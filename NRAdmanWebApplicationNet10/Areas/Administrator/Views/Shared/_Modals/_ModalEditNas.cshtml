@model NRAdmanWebApplicationNet10.ViewModels.NasViewModel

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasEditNas" aria-labelledby="offcanvasEditNasLabel">
    <div class="offcanvas-header">
        <h5 id="offcanvasEditNasLabel" class="offcanvas-title">Edit NAS</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <form id="form-edit-nas-modal">
            @Html.AntiForgeryToken()
            <div class="text-danger mb-3" id="form-error-summary"></div>

            <input type="hidden" id="modalNasId" name="Id" value="@Model.Id" />

            <div class="mb-3">
                <label for="nasName" class="form-label">NAS Name</label>
                <input type="text" id="nasName" name="NasName" class="form-control" value="@Model.NasName" />
                <span class="text-danger" id="error-nasName"></span>
                <span class="form-text">Pastikan NAS Name unik.</span>
            </div>

            <div class="mb-3">
                <label for="shortName" class="form-label">Short Name</label>
                <input type="text" id="shortName" name="ShortName" class="form-control" value="@Model.ShortName" />
                <span class="text-danger" id="error-shortName"></span>
            </div>

            <div class="mb-3">
                <label for="type" class="form-label">Type</label>
                <input type="text" id="type" name="Type" class="form-control" value="@Model.Type" />
                <span class="text-danger" id="error-type"></span>
            </div>

            <div class="mb-3">
                <label for="ports" class="form-label">Ports</label>
                <input type="number" id="ports" name="Ports" class="form-control" value="@Model.Ports" />
                <span class="text-danger" id="error-ports"></span>
            </div>

            <div class="mb-3">
                <label for="secret" class="form-label">Secret</label>
                <input type="text" id="secret" name="Secret" class="form-control" value="@Model.Secret" />
                <span class="text-danger" id="error-secret"></span>
            </div>

            <div class="mb-3">
                <label for="server" class="form-label">Server</label>
                <input type="text" id="server" name="Server" class="form-control" value="@Model.Server" />
                <span class="text-danger" id="error-server"></span>
            </div>

            <div class="mb-3">
                <label for="community" class="form-label">Community</label>
                <input type="text" id="community" name="Community" class="form-control" value="@Model.Community" />
                <span class="text-danger" id="error-community"></span>
            </div>

            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea id="description" name="Description" class="form-control">@Model.Description</textarea>
                <span class="text-danger" id="error-description"></span>
            </div>

            <div class="mb-3">
                <label for="routerType" class="form-label">Router Type</label>
                <select id="routerType" name="RouterType" class="form-select">
                    @foreach (var item in Html.GetEnumSelectList<NRAdmanWebApplicationNet10.Models.EnumRouterType>())
                    {
                        <option value="@item.Value" selected="@(item.Value == Model.RouterType.ToString())">@item.Text</option>
                    }
                </select>
                <span class="text-danger" id="error-routerType"></span>
            </div>

            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input type="text" id="username" name="Username" class="form-control" value="@Model.Username" />
                <span class="text-danger" id="error-username"></span>
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input type="password" id="password" name="Password" class="form-control" value="@Model.Password" />
                <span class="text-danger" id="error-password"></span>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="offcanvas">Cancel</button>
                <button type="submit" class="btn btn-primary">Update</button>
            </div>
        </form>
    </div>
</div>

@section PageScripts {
    <script>
        $(function() {
            $('#form-edit-nas-modal').on('submit', function(e) {
                e.preventDefault();

                var form = $(this);
                var formData = form.serialize();
                var nasId = $('#modalNasId').val();

                $.ajax({
                    url: '@Url.Action("UpdateNas", "SettingsNas", new { area = "Administrator" })/' + nasId,
                    type: 'POST',
                    data: formData,
                    success: function(response) {
                        if (response.success) {
                            // Close offcanvas
                            var offcanvas = bootstrap.Offcanvas.getInstance(document.getElementById('offcanvasEditNas'));
                            if (offcanvas) offcanvas.hide();

                            // Show success message
                            alert(response.message);

                            // Reload DataTable
                            if (window.dataTable && window.dataTable.ajax) {
                                window.dataTable.ajax.reload();
                            }

                            // Reset form
                            form[0].reset();
                        } else {
                            // Show error message
                            $('#form-error-summary').html(response.message);
                        }
                    },
                    error: function(xhr, status, error) {
                        $('#form-error-summary').html('Terjadi kesalahan. Silakan coba lagi.');
                        console.error('Error:', error);
                    }
                });
            });
        });
    </script>
}
