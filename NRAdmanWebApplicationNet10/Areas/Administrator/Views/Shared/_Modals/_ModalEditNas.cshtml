@model NRAdmanWebApplicationNet10.ViewModels.NasViewModel

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasEditNas" aria-labelledby="offcanvasEditNasLabel">
    <div class="offcanvas-header">
        <h5 id="offcanvasEditNasLabel" class="offcanvas-title">Edit NAS</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <form id="form-edit-nas-modal">
            @Html.AntiForgeryToken()
            <div class="text-danger mb-3" id="form-edit-error-summary"></div>

            <input type="hidden" id="modalNasId" name="Id" value="@Model.Id" />

            <div class="mb-3">
                <label for="editNasName" class="form-label">NAS Name</label>
                <input asp-for="NasName" type="text" id="editNasName" name="NasName" class="form-control" placeholder="192.168.1.1"/>
                <span class="text-danger" id="error-editNasName"></span>
                <span class="form-text">Pastikan NAS Name unik.</span>
            </div>

            <div class="mb-3">
                <label for="editShortName" class="form-label">Short Name</label>
                <input asp-for="ShortName" type="text" id="editShortName" name="ShortName" class="form-control" />
                <span class="text-danger" id="error-editShortName"></span>
            </div>

            <div class="mb-3">
                <label for="editType" class="form-label">Type</label>
                <input asp-for="Type" type="text" id="editType" name="Type" class="form-control" />
                <span class="text-danger" id="error-editType"></span>
            </div>

            <div class="mb-3">
                <label for="editPorts" class="form-label">Ports</label>
                <input asp-for="Ports" type="number" id="editPorts" name="Ports" class="form-control" />
                <span class="text-danger" id="error-editPorts"></span>
            </div>

            <div class="mb-3">
                <label for="editSecret" class="form-label">Secret</label>
                <input asp-for="Secret" type="text" id="editSecret" name="Secret" class="form-control" />
                <span class="text-danger" id="error-editSecret"></span>
            </div>

            <div class="mb-3">
                <label for="editServer" class="form-label">Server</label>
                <input asp-for="Server" type="text" id="editServer" name="Server" class="form-control" />
                <span class="text-danger" id="error-editServer"></span>
            </div>

            <div class="mb-3">
                <label for="editCommunity" class="form-label">Community</label>
                <input asp-for="Community" type="text" id="editCommunity" name="Community" class="form-control" />
                <span class="text-danger" id="error-editCommunity"></span>
            </div>

            <div class="mb-3">
                <label for="editDescription" class="form-label">Description</label>
                <textarea asp-for="Description" id="editDescription" name="Description" class="form-control"></textarea>
                <span class="text-danger" id="error-editDescription"></span>
            </div>            

            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="offcanvas">Cancel</button>
                <button type="submit" class="btn btn-primary">Update</button>
            </div>
        </form>
    </div>
</div>

<script>
    $(function() {
        $('#form-edit-nas-modal').on('submit', function(e) {
            e.preventDefault();            

            var form = $(this);
            var formData = form.serialize();
            var nasId = $('#modalNasId').val();

            $.ajax({
                url: '@Url.Action("Update", "SettingsNas", new { area = "Administrator" })/' + nasId,
                type: 'POST',
                data: formData,
                success: function(response) {
                    if (response.success) {
                        ToastHelper.success(response.message);

                        // Close offcanvas
                        var offcanvas = bootstrap.Offcanvas.getInstance(document.getElementById('offcanvasEditNas'));
                        if (offcanvas) offcanvas.hide();

                        // Reload DataTable
                        if (window.dataTable && window.dataTable.ajax) {
                            window.dataTable.ajax.reload();
                        }

                        // Reset form
                        form[0].reset();
                        $('#form-edit-error-summary').html('');
                        clearFieldErrors();
                    } else {
                        // Show error toast with detailed message
                        let errorMessage = response.message;
                        if (response.errors && response.errors.length > 0) {
                            ToastHelper.error(response.errors.join('\n'));
                            displayFieldErrors(response.errors);
                        } else {
                            ToastHelper.error(errorMessage);
                        }
                    }
                },
                error: function(xhr, status, error) {
                    let errorMessage = 'Terjadi kesalahan. Silakan coba lagi.';
                    try {
                        var response = JSON.parse(xhr.responseText);
                        if (response.message) {
                            errorMessage = response.message;
                        }
                        if (response.errors && response.errors.length > 0) {
                            errorMessage += '\n' + response.errors.join('\n');
                        }
                    } catch (e) {
                        // Response is not JSON
                        console.error('JSON Parse Error:', e);

                        // fallback plain text
                        if (xhr.responseText) {
                            errorMessage = xhr.responseText;
                        }
                    }
                    ToastHelper.error(errorMessage);
                    console.error('Error:', error);
                }
            });
        });
    });

    function clearFieldErrors() {
        $('#form-edit-nas-modal .text-danger').html('');
        $('#form-edit-nas-modal .form-control').removeClass('is-invalid');
        $('#form-edit-nas-modal .form-select').removeClass('is-invalid');
    }

    function displayFieldErrors(errors) {
        clearFieldErrors();

        errors.forEach(function(error) {
             const lowerError = error.toLowerCase();
                console.log(error);
            // Try to match error to field
            if (lowerError.includes('nas name')) {
                $('#error-editNasName').html(error);
                $('#editNasName').addClass('is-invalid');
            } else if (lowerError.includes('short name')) {
                $('#error-editShortName').html(error);
                $('#editShortName').addClass('is-invalid');
            } else if (lowerError.includes('type')) {
                $('#error-editType').html(error);
                $('#editType').addClass('is-invalid');
            } else if (lowerError.includes('ports')) {
                $('#error-editPorts').html(error);
                $('#editPorts').addClass('is-invalid');
            } else if (lowerError.includes('secret')) {
                $('#error-editSecret').html(error);
                $('#editSecret').addClass('is-invalid');
            } else if (lowerError.includes('server')) {
                $('#error-editServer').html(error);
                $('#editServer').addClass('is-invalid');
            } else if (lowerError.includes('community')) {
                $('#error-editCommunity').html(error);
                $('#editCommunity').addClass('is-invalid');
            } else if (lowerError.includes('description')) {
                $('#error-editDescription').html(error);
                $('#editDescription').addClass('is-invalid');
            } 
        });
    }
</script>
