@model NRAdmanWebApplicationNet10.ViewModels.RouterViewModel

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasCreateRouter" aria-labelledby="offcanvasCreateRouterLabel">
    <div class="offcanvas-header">
        <h5 id="offcanvasCreateRouterLabel" class="offcanvas-title">Create Router</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <form id="form-create-router">
            @Html.AntiForgeryToken()
            <div class="text-danger mb-3" id="form-create-error-summary"></div>

            <div class="mb-3">
                <label for="createRouterType" class="form-label">Router Type</label>
                <select id="createRouterType" class="form-select" asp-for="RouterType" name="RouterType" asp-items="Html.GetEnumSelectList<NRAdmanWebApplicationNet10.Models.EnumRouterType>()"></select>                
                <span class="text-danger" id="error-createRouterType"></span>
            </div>

            <div class="mb-3">
                <label for="createRouterName" class="form-label">Router Name</label>
                <input asp-for="Name" type="text" id="createRouterName" name="Name" class="form-control" placeholder="Main Office Router" />
                <span class="text-danger" id="error-createRouterName"></span>
                <span class="form-text">Pastikan Router Name unik.</span>
            </div>

            <div class="mb-3">
                <label for="createIpAddress" class="form-label">IP Address</label>
                <input asp-for="IpAddress" type="text" id="createIpAddress" name="IpAddress" class="form-control" placeholder="192.168.1.1" />
                <span class="text-danger" id="error-createIpAddress"></span>
                <span class="form-text">Pastikan IP Address unik.</span>
            </div>

            <div class="mb-3">
                <label for="createUsername" class="form-label">Username</label>
                <input asp-for="Username" type="text" id="createUsername" name="Username" class="form-control" value="admin" />
                <span class="text-danger" id="error-createUsername"></span>
            </div>

            <div class="mb-3">
                <label for="createPassword" class="form-label">Password</label>
                <input asp-for="Password" type="password" id="createPassword" name="Password" class="form-control" value="admin" />
                <span class="text-danger" id="error-createPassword"></span>
            </div>

            <div class="mb-3">
                <label for="createRouterPorts" class="form-label">SSH Port</label>
                <input asp-for="SshPorts" type="number" id="createRouterPorts" name="SshPorts" class="form-control" value="22" />
                <span class="text-danger" id="error-createPorts"></span>
            </div>

            <div class="mb-3">
                <label for="createDescription" class="form-label">Description</label>
                <textarea asp-for="Description" id="createDescription" name="Description" class="form-control" rows="2" placeholder="e.g., Main office router, Secondary router, etc."></textarea>
                <span class="text-danger" id="error-createDescription"></span>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="offcanvas">Cancel</button>
                <button type="submit" class="btn btn-primary">Create</button>
            </div>
        </form>
    </div>
</div>

<script>
    $(function() {
        $('#form-create-router').on('submit', function(e) {
            e.preventDefault();
            clearFieldErrors();

            var form = $(this);
            var formData = form.serialize();

            $.ajax({
                url: '@Url.Action("Create", "SettingsRouter", new { area = "Administrator" })',
                type: 'POST',
                data: formData,
                success: function(response) {
                    if (response.success) {
                        ToastHelper.success(response.message);

                        // Close offcanvas
                        var offcanvas = bootstrap.Offcanvas.getInstance(document.getElementById('offcanvasCreateRouter'));
                        if (offcanvas) offcanvas.hide();

                        // Reload DataTable
                        if (window.dataTable && window.dataTable.ajax) {
                            window.dataTable.ajax.reload();
                        }

                        // Reset form
                        form[0].reset();
                        $('#form-create-error-summary').html('');
                        clearFieldErrors();
                    } else {
                        let errorMessage = response.message;
                        if (response.errors && response.errors.length > 0) {
                            ToastHelper.error(response.errors.join('\n'));
                            displayFieldErrors(response.errors);
                        } else {
                            ToastHelper.error(errorMessage);
                        }
                    }
                },
                error: function(xhr, status, error) {
                    let errorMessage = 'Terjadi kesalahan. Silakan coba lagi.';
                    try {
                        var response = JSON.parse(xhr.responseText);
                        if (response.message) {
                            errorMessage = response.message;
                        }
                        if (response.errors && response.errors.length > 0) {
                            errorMessage += '\n' + response.errors.join('\n');
                        }
                    } catch (e) {
                        console.error('JSON Parse Error:', e);
                        if (xhr.responseText) {
                            errorMessage = xhr.responseText;
                        }
                    }
                    ToastHelper.error(errorMessage);
                    console.error('Error:', error);
                }
            });
        });
    });

    function clearFieldErrors() {
      $('#form-create-router .text-danger').html('');
        $('#form-create-router .form-control').removeClass('is-invalid');
        $('#form-create-router .form-select').removeClass('is-invalid');
        $('#form-create-router .form-check-input').removeClass('is-invalid');
    }

    function displayFieldErrors(errors) {
        clearFieldErrors();

            errors.forEach(function(error) {
                const lowerError = error.toLowerCase();
                console.log(error);
                // Try to match error to field
                if (lowerError.includes('ip address')) {
                    $('#error-createIpAddress').html(error);
                    $('#createIpAddress').addClass('is-invalid');
                } else if (lowerError.includes('name')) {
                    $('#error-createRouterName').html(error);
                    $('#createRouterName').addClass('is-invalid');
                }  else if (lowerError.includes('username')) {
                    $('#error-createUsername').html(error);
                    $('#createUsername').addClass('is-invalid');
                } else if (lowerError.includes('password')) {
                    $('#error-createPassword').html(error);
                    $('#createPassword').addClass('is-invalid');
                } else if (lowerError.includes('port')) {
                    $('#error-createRouterPorts').html(error);
                    $('#createRouterPorts').addClass('is-invalid');
                } else if (lowerError.includes('router type')) {
                    $('#error-createRouterType').html(error);
                    $('#createRouterType').addClass('is-invalid');
                }
       });
    }
</script>
