@model NRAdmanWebApplicationNet10.ViewModels.MikrotikSimpleQueueViewModel

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasEditRouterQueue" aria-labelledby="offcanvasEditRouterQueueLabel">
    <div class="offcanvas-header">
        <h5 id="offcanvasEditRouterQueueLabel" class="offcanvas-title">Edit Router Queue</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <form id="form-edit-queue-modal">
            @Html.AntiForgeryToken()
            <div class="text-danger mb-3" id="form-edit-error-summary"></div>

            <input type="hidden" id="editModalQueueId" name="Id" value="@Model.Id" />

            <div class="mb-3">
                <label for="editNasId" class="form-label">NAS</label>
                <select asp-for="NasId" asp-items="ViewBag.NasOptions" id="editNasId" name="NasId" class="form-select">
                    <option value="">-- Pilih NAS --</option>
                </select>
                <span class="text-danger" id="error-editNasId"></span>
            </div>
            
            <div class="mb-3">
                <label for="editQueueName" class="form-label">Queue Name</label>
                <input asp-for="QueueName" type="text" id="editQueueName" name="QueueName" class="form-control" />
                <span class="text-danger" id="error-editQueueName"></span>
            </div>

            <div class="mb-3">
                <label for="editTargetAddress" class="form-label">Target Address (IP/Subnet)</label>
                <input asp-for="TargetAddress" type="text" id="editTargetAddress" name="TargetAddress" class="form-control" placeholder="192.168.1.0/24" />
                <span class="text-danger" id="error-editTargetAddress"></span>
                <small class="form-text">Format: 192.168.1.100 atau 192.168.1.0/24</small>
            </div>

            <div class="mb-3">
                <label for="editParent" class="form-label">Parent Queue (Optional)</label>
                <input asp-for="Parent" type="text" id="editParent" name="Parent" class="form-control" />
                <span class="text-danger" id="error-editParent"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="editMaxLimit" class="form-label">Max Limit (bps)</label>
                    <input asp-for="MaxLimit" type="number" id="editMaxLimit" name="MaxLimit" class="form-control" placeholder="1000000" />
                    <span class="text-danger" id="error-editMaxLimit"></span>
                    <small class="form-text">Contoh: 1000000 = 1 Mbps</small>
                </div>

                <div class="col-md-6 mb-3">
                    <label for="editBurstLimit" class="form-label">Burst Limit (bps)</label>
                    <input asp-for="BurstLimit" type="number" id="editBurstLimit" name="BurstLimit" class="form-control" />
                    <span class="text-danger" id="error-editBurstLimit"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="editBurstThreshold" class="form-label">Burst Threshold (bps)</label>
                    <input asp-for="BurstThreshold" type="number" id="editBurstThreshold" name="BurstThreshold" class="form-control" />
                    <span class="text-danger" id="error-editBurstThreshold"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label for="editBurstTime" class="form-label">Burst Time (seconds)</label>
                    <input asp-for="BurstTime" type="number" id="editBurstTime" name="BurstTime" class="form-control" />
                    <span class="text-danger" id="error-editBurstTime"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="editPriority" class="form-label">Priority</label>
                    <select asp-for="Priority" id="editPriority" name="Priority" class="form-select">
                        <option value="0">0 - Highest</option>
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                        <option value="5">5</option>
                        <option value="6">6</option>
                        <option value="7">7</option>
                        <option value="8">8 - Default</option>
                        <option value="9">9</option>
                        <option value="10">10</option>
                        <option value="11">11</option>
                        <option value="12">12</option>
                        <option value="13">13</option>
                        <option value="14">14</option>
                        <option value="15">15</option>
                        <option value="16">16 - Lowest</option>
                    </select>
                    <span class="text-danger" id="error-editPriority"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label for="editPacketMark" class="form-label">Packet Mark (Optional)</label>
                    <input asp-for="PacketMark" type="text" id="editPacketMark" name="PacketMark" class="form-control" />
                    <span class="text-danger" id="error-editPacketMark"></span>
                </div>
            </div>

            <div class="mb-3">
                <label for="editComment" class="form-label">Comment (Optional)</label>
                <textarea asp-for="Comment" id="editComment" name="Comment" class="form-control" rows="3"></textarea>
                <span class="text-danger" id="error-editComment"></span>
            </div>

            <div class="mb-3 form-check">
                <input type="checkbox" asp-for="Disabled" id="editDisabled" name="Disabled" class="form-check-input" />
                <label class="form-check-label" for="editDisabled">Disable Queue</label>
            </div>
            
            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="offcanvas">Cancel</button>
                <button type="submit" class="btn btn-primary">Update</button>
            </div>
        </form>
    </div>
</div>

<script>
    $(function() {
        $('#form-edit-queue-modal').on('submit', function(e) {
            e.preventDefault();
            clearFieldErrors();

            var form = $(this);
            var formData = form.serialize();
            var queueId = $('#editModalQueueId').val();

            $.ajax({
                url: '@Url.Action("Update", "RouterQueue", new { area = "Administrator" })/' + queueId,
                type: 'POST',
                data: formData,
                success: function(response) {
                    if (response.success) {
                        ToastHelper.success(response.message);

                        // Close offcanvas
                        var offcanvas = bootstrap.Offcanvas.getInstance(document.getElementById('offcanvasEditRouterQueue'));
                        if (offcanvas) offcanvas.hide();

                        // Reload DataTable
                        if (window.dataTable && window.dataTable.ajax) {
                            window.dataTable.ajax.reload();
                        }

                        // Reset form
                        form[0].reset();
                        $('#form-edit-error-summary').html('');
                        clearFieldErrors();
                    } else {
                        // Show error toast with detailed message
                        let errorMessage = response.message;
                        if (response.errors && response.errors.length > 0) {
                            ToastHelper.error(response.errors.join('\n'));
                            displayFieldErrors(response.errors);
                        } else {
                            ToastHelper.error(errorMessage);
                        }
                    }
                },
                error: function(xhr, status, error) {
                    let errorMessage = 'Terjadi kesalahan. Silakan coba lagi.';
                    try {
                        var response = JSON.parse(xhr.responseText);
                        if (response.message) {
                            errorMessage = response.message;
                        }
                        if (response.errors && response.errors.length > 0) {
                            errorMessage += '\n' + response.errors.join('\n');
                        }
                    } catch (e) {
                        // Response is not JSON
                        console.error('JSON Parse Error:', e);

                        // fallback plain text
                        if (xhr.responseText) {
                            errorMessage = xhr.responseText;
                        }
                    }
                    ToastHelper.error(errorMessage);
                    console.error('Error:', error);
                }
            });
        });
    });

    function clearFieldErrors() {
        $('#form-edit-queue-modal .text-danger').html('');
        $('#form-edit-queue-modal .form-control').removeClass('is-invalid');
        $('#form-edit-queue-modal .form-select').removeClass('is-invalid');
    }

    function displayFieldErrors(errors) {
        clearFieldErrors();

        errors.forEach(function(error) {
            // Try to match error to field
            if (error.toLowerCase().includes('nasid')) {
                $('#error-editNasId').html(error);
                $('#editNasId').addClass('is-invalid');
            } else if (error.toLowerCase().includes('queuename')) {
                $('#error-editQueueName').html(error);
                $('#editQueueName').addClass('is-invalid');
            } else if (error.toLowerCase().includes('targetaddress')) {
                $('#error-editTargetAddress').html(error);
                $('#editTargetAddress').addClass('is-invalid');
            } else if (error.toLowerCase().includes('parent')) {
                $('#error-editParent').html(error);
                $('#editParent').addClass('is-invalid');
            } else if (error.toLowerCase().includes('maxlimit')) {
                $('#error-editMaxLimit').html(error);
                $('#editMaxLimit').addClass('is-invalid');
            } else if (error.toLowerCase().includes('burstlimit')) {
                $('#error-editBurstLimit').html(error);
                $('#editBurstLimit').addClass('is-invalid');
            } else if (error.toLowerCase().includes('burstthreshold')) {
                $('#error-editBurstThreshold').html(error);
                $('#editBurstThreshold').addClass('is-invalid');
            } else if (error.toLowerCase().includes('bursttime')) {
                $('#error-editBurstTime').html(error);
                $('#editBurstTime').addClass('is-invalid');
            } else if (error.toLowerCase().includes('priority')) {
                $('#error-editPriority').html(error);
                $('#editPriority').addClass('is-invalid');
            } else if (error.toLowerCase().includes('packetmark')) {
                $('#error-editPacketMark').html(error);
                $('#editPacketMark').addClass('is-invalid');
            } else if (error.toLowerCase().includes('comment')) {
                $('#error-editComment').html(error);
                $('#editComment').addClass('is-invalid');
            }
        });
    }
</script>
