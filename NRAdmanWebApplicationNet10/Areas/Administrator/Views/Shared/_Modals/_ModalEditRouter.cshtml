@model NRAdmanWebApplicationNet10.ViewModels.RouterViewModel

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasEditRouter" aria-labelledby="offcanvasEditRouterLabel">
    <div class="offcanvas-header">
        <h5 id="offcanvasEditRouterLabel" class="offcanvas-title">Edit Router</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <form id="form-edit-router">
            @Html.AntiForgeryToken()
            <div class="text-danger mb-3" id="form-edit-error-summary"></div>

            <input type="hidden" id="modalRouterId" name="Id" value="@Model.Id" />

            <div class="mb-3">
                <label for="editRouterType" class="form-label">Router Type</label>
                <select id="editRouterType" class="form-select" asp-for="RouterType" name="RouterType" asp-items="Html.GetEnumSelectList<NRAdmanWebApplicationNet10.Models.EnumRouterType>()"></select>                
                <span class="text-danger" id="error-editRouterType"></span>
            </div>
            
            <div class="mb-3">
                <label for="editRouterName" class="form-label">Router Name</label>
                <input asp-for="Name" type="text" id="editRouterName" name="Name" class="form-control" placeholder="Main Office Router" />
                <span class="text-danger" id="error-editRouterName"></span>
                <span class="form-text">Pastikan Router Name unik.</span>
            </div>

            <div class="mb-3">
                <label for="editIpAddress" class="form-label">IP Address</label>
                <input asp-for="IpAddress" type="text" id="editIpAddress" name="IpAddress" class="form-control" />
                <span class="text-danger" id="error-editIpAddress"></span>
                <span class="form-text">Pastikan IP Address unik.</span>
            </div>

            <div class="mb-3">
                <label for="editUsername" class="form-label">Username</label>
                <input asp-for="Username" type="text" id="editUsername" name="Username" class="form-control" />
                <span class="text-danger" id="error-editUsername"></span>
            </div>

            <div class="mb-3">
                <label for="editPassword" class="form-label">Password</label>
                <input asp-for="Password" type="password" id="editPassword" name="Password" class="form-control" />
                <span class="text-danger" id="error-editPassword"></span>
            </div>

            <div class="mb-3">
                <label for="editRouterPorts" class="form-label">SSH Port</label>
                <input asp-for="Ports" type="number" id="editRouterPorts" name="Ports" class="form-control" />
                <span class="text-danger" id="error-editRouterPorts"></span>
            </div>

            <div class="mb-3">
                <label for="editDescription" class="form-label">Description</label>
                <textarea asp-for="Description" id="editDescription" name="Description" class="form-control" rows="2" placeholder="e.g., Main office router, Secondary router, etc."></textarea>
                <span class="text-danger" id="error-editDescription"></span>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="offcanvas">Cancel</button>
                <button type="submit" class="btn btn-primary">Update</button>
            </div>
        </form>
    </div>
</div>

<script>
    $(function() {
        // Set the router type on load
        $('#editRouterType').val((Model.RouterType).toString());

        $('#form-edit-router').on('submit', function(e) {
            e.preventDefault();

            var form = $(this);
            var formData = form.serialize();
            var routerId = $('#modalRouterId').val();

            $.ajax({
                url: '@Url.Action("Update", "SettingsRouter", new { area = "Administrator" })/' + routerId,
                type: 'POST',
                data: formData,
                success: function(response) {
                    if (response.success) {
                        ToastHelper.success(response.message);

                        // Close offcanvas
                        var offcanvas = bootstrap.Offcanvas.getInstance(document.getElementById('offcanvasEditRouter'));
                        if (offcanvas) offcanvas.hide();

                        // Reload DataTable
                        if (window.dataTable && window.dataTable.ajax) {
                            window.dataTable.ajax.reload();
                        }

                        // Reset form
                        form[0].reset();
                        $('#form-edit-error-summary').html('');
                        clearFieldErrors();
                    } else {
                        let errorMessage = response.message;
                        if (response.errors && response.errors.length > 0) {
                            ToastHelper.error(response.errors.join('\n'));
                            displayFieldErrors('edit', response.errors);
                        } else {
                            ToastHelper.error(errorMessage);
                        }
                    }
                },
                error: function(xhr, status, error) {
                    let errorMessage = 'Terjadi kesalahan. Silakan coba lagi.';
                    try {
                        var response = JSON.parse(xhr.responseText);
                        if (response.message) {
                            errorMessage = response.message;
                        }
                        if (response.errors && response.errors.length > 0) {
                            errorMessage += '\n' + response.errors.join('\n');
                        }
                    } catch (e) {
                        console.error('JSON Parse Error:', e);
                        if (xhr.responseText) {
                            errorMessage = xhr.responseText;
                        }
                    }
                    ToastHelper.error(errorMessage);
                    console.error('Error:', error);
                }
            });
        });
    });

    function clearFieldErrors(prefix = '') {
        $('#form-edit-router .text-danger').html('');
        $('#form-edit-router .form-control').removeClass('is-invalid');
        $('#form-edit-router .form-select').removeClass('is-invalid');
        $('#form-edit-router .form-check-input').removeClass('is-invalid');        
    }

    function displayFieldErrors(errors) {
        clearFieldErrors();
                
        errors.forEach(function(error) {
            const lowerError = error.toLowerCase();
            console.log(error);
            // Try to match error to field
            if (lowerError.includes('ip address')) {
                $('#error-editIpAddress').html(error);
                $('#editIpAddress').addClass('is-invalid');
            } else if (lowerError.includes('name')) {
                    $('#error-editRouterName').html(error);
                    $('#editRouterName').addClass('is-invalid');
            } else if (lowerError.includes('username')) {
                $('#error-editUsername').html(error);
                $('#editUsername').addClass('is-invalid');
            } else if (lowerError.includes('password')) {
                $('#error-editPassword').html(error);
                $('#editPassword').addClass('is-invalid');
            } else if (lowerError.includes('port')) {
                $('#error-editRouterPorts').html(error);
                $('#editRouterPorts').addClass('is-invalid');
            } else if (lowerError.includes('router type')) {
                $('#error-editRouterType').html(error);
                $('#editRouterType').addClass('is-invalid');
            }
        });
    }
</script>
