@model NRAdmanWebApplicationNet10.ViewModels.RouterViewModel

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasEditRouter" aria-labelledby="offcanvasEditRouterLabel">
    <div class="offcanvas-header">
        <h5 id="offcanvasEditRouterLabel" class="offcanvas-title">Edit Router</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <form id="form-edit-router-modal">
            @Html.AntiForgeryToken()
            <div class="text-danger mb-3" id="form-edit-error-summary"></div>

            <input type="hidden" id="modalRouterId" name="Id" value="@Model.Id" />

            <div class="mb-3">
                <label for="editRouterType" class="form-label">Router Type</label>
                <select id="editRouterType" name="RouterType" class="form-select">
                    <option value="0">MikroTik</option>
                    <option value="1">Cisco</option>
                    <option value="2">Juniper</option>
                    <option value="3">Other</option>
                </select>
                <span class="text-danger" id="error-editRouterType"></span>
            </div>

            <div class="mb-3">
                <label for="editIpAddress" class="form-label">IP Address</label>
                <input type="text" id="editIpAddress" name="IpAddress" class="form-control" value="@Model.IpAddress" />
                <span class="text-danger" id="error-editIpAddress"></span>
                <span class="form-text">Pastikan IP Address unik.</span>
            </div>

            <div class="mb-3">
                <label for="editUsername" class="form-label">Username</label>
                <input type="text" id="editUsername" name="Username" class="form-control" value="@Model.Username" />
                <span class="text-danger" id="error-editUsername"></span>
            </div>

            <div class="mb-3">
                <label for="editPassword" class="form-label">Password</label>
                <input type="password" id="editPassword" name="Password" class="form-control" value="@Model.Password" />
                <span class="text-danger" id="error-editPassword"></span>
            </div>

            <div class="mb-3">
                <label for="editRouterPorts" class="form-label">SSH Port</label>
                <input type="number" id="editRouterPorts" name="Ports" class="form-control" value="@Model.Ports" />
                <span class="text-danger" id="error-editRouterPorts"></span>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="offcanvas">Cancel</button>
                <button type="submit" class="btn btn-primary">Update</button>
            </div>
        </form>
    </div>
</div>

<script>
    $(function() {
        // Set the router type on load
        $('#editRouterType').val((Model.RouterType).toString());

        $('#form-edit-router-modal').on('submit', function(e) {
            e.preventDefault();

            var form = $(this);
            var formData = form.serialize();
            var routerId = $('#modalRouterId').val();

            $.ajax({
                url: '@Url.Action("Update", "SettingsRouter", new { area = "Administrator" })/' + routerId,
                type: 'POST',
                data: formData,
                success: function(response) {
                    if (response.success) {
                        ToastHelper.success(response.message);

                        // Close offcanvas
                        var offcanvas = bootstrap.Offcanvas.getInstance(document.getElementById('offcanvasEditRouter'));
                        if (offcanvas) offcanvas.hide();

                        // Reload DataTable
                        if (window.dataTable && window.dataTable.ajax) {
                            window.dataTable.ajax.reload();
                        }

                        // Reset form
                        form[0].reset();
                        $('#form-edit-error-summary').html('');
                        clearFieldErrors();
                    } else {
                        let errorMessage = response.message;
                        if (response.errors && response.errors.length > 0) {
                            ToastHelper.error(response.errors.join('\n'));
                            displayFieldErrors('edit', response.errors);
                        } else {
                            ToastHelper.error(errorMessage);
                        }
                    }
                },
                error: function(xhr, status, error) {
                    let errorMessage = 'Terjadi kesalahan. Silakan coba lagi.';
                    try {
                        var response = JSON.parse(xhr.responseText);
                        if (response.message) {
                            errorMessage = response.message;
                        }
                        if (response.errors && response.errors.length > 0) {
                            errorMessage += '\n' + response.errors.join('\n');
                        }
                    } catch (e) {
                        console.error('JSON Parse Error:', e);
                        if (xhr.responseText) {
                            errorMessage = xhr.responseText;
                        }
                    }
                    ToastHelper.error(errorMessage);
                    console.error('Error:', error);
                }
            });
        });
    });

    function clearFieldErrors(prefix = '') {
        const selector = prefix ? `#form-${prefix}-router-modal` : '#form-edit-router-modal';
        $(selector + ' .text-danger').html('');
        $(selector + ' .form-control').removeClass('is-invalid');
        $(selector + ' .form-select').removeClass('is-invalid');
        $(selector + ' .form-check-input').removeClass('is-invalid');
    }

    function displayFieldErrors(prefix, errors) {
        clearFieldErrors(prefix);

        const fieldPrefix = prefix === 'create' ? 'create' : 'edit';
        errors.forEach(function(error) {
            const lowerError = error.toLowerCase();

            if (lowerError.includes('ip address')) {
                $('#error-' + fieldPrefix + 'IpAddress').html(error);
                $('#' + fieldPrefix + 'IpAddress').addClass('is-invalid');
            } else if (lowerError.includes('username')) {
                $('#error-' + fieldPrefix + 'Username').html(error);
                $('#' + fieldPrefix + 'Username').addClass('is-invalid');
            } else if (lowerError.includes('password')) {
                $('#error-' + fieldPrefix + 'Password').html(error);
                $('#' + fieldPrefix + 'Password').addClass('is-invalid');
            } else if (lowerError.includes('port')) {
                $('#error-' + fieldPrefix + 'RouterPorts').html(error);
                $('#' + fieldPrefix + 'RouterPorts').addClass('is-invalid');
            } else if (lowerError.includes('router type')) {
                $('#error-' + fieldPrefix + 'RouterType').html(error);
                $('#' + fieldPrefix + 'RouterType').addClass('is-invalid');
            }
        });
    }
</script>
