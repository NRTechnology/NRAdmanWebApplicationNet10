@model NRAdmanWebApplicationNet10.ViewModels.NasViewModel

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasCreateNas" aria-labelledby="offcanvasCreateNasLabel">
    <div class="offcanvas-header">
        <h5 id="offcanvasCreateNasLabel" class="offcanvas-title">Create NAS</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <form id="form-create-nas">
            @Html.AntiForgeryToken()
            <div class="text-danger mb-3" id="form-create-error-summary"></div>
            <div class="mb-3">
                <label for="createNasName" class="form-label">NAS Name</label>
                <input asp-for="NasName" type="text" id="createNasName" name="NasName" class="form-control" placeholder="192.168.1.1" />
                <span class="text-danger" id="error-createNasName"></span>
                <span class="form-text">Pastikan NAS Name unik.</span>
            </div>

            <div class="mb-3">
                <label for="createShortName" class="form-label">Short Name</label>
                <input asp-for="ShortName" type="text" id="createShortName" name="ShortName" class="form-control" />
                <span class="text-danger" id="error-createShortName"></span>
            </div>

            <div class="mb-3">
                <label for="createType" class="form-label">Type</label>
                <input asp-for="Type" type="text" id="createType" name="Type" class="form-control" />
                <span class="text-danger" id="error-createType"></span>
            </div>

            <div class="mb-3">
                <label for="createPorts" class="form-label">Ports</label>
                <input asp-for="Ports" type="number" id="createPorts" name="Ports" class="form-control" />
                <span class="text-danger" id="error-createPorts"></span>
            </div>

            <div class="mb-3">
                <label for="createSecret" class="form-label">Secret</label>
                <input asp-for="Secret" type="text" id="createSecret" name="Secret" class="form-control" />
                <span class="text-danger" id="error-createSecret"></span>
            </div>

            <div class="mb-3">
                <label for="createServer" class="form-label">Server</label>
                <input asp-for="Server" type="text" id="createServer" name="Server" class="form-control" />
                <span class="text-danger" id="error-createServer"></span>
            </div>

            <div class="mb-3">
                <label for="createCommunity" class="form-label">Community</label>
                <input asp-for="Community" type="text" id="createCommunity" name="Community" class="form-control" />
                <span class="text-danger" id="error-createCommunity"></span>
            </div>

            <div class="mb-3">
                <label for="createDescription" class="form-label">Description</label>
                <textarea asp-for="Description" id="createDescription" name="Description" class="form-control"></textarea>
                <span class="text-danger" id="error-createDescription"></span>
            </div>            

            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="offcanvas">Cancel</button>
                <button type="submit" class="btn btn-primary">Create</button>
            </div>
        </form>
    </div>
</div>

<script>
    $(function() {
        $('#form-create-nas').on('submit', function(e) {
            e.preventDefault();
            clearFieldErrors('create');

            var form = $(this);
            var formData = form.serialize();

            $.ajax({
                url: '@Url.Action("Create", "SettingsNas", new { area = "Administrator" })',
                type: 'POST',
                data: formData,
                success: function(response) {
                    if (response.success) {
                        ToastHelper.success(response.message);

                        // Close offcanvas
                        var offcanvas = bootstrap.Offcanvas.getInstance(document.getElementById('offcanvasCreateNas'));
                        if (offcanvas) offcanvas.hide();

                        // Reload DataTable
                        if (window.dataTable && window.dataTable.ajax) {
                            window.dataTable.ajax.reload();
                        }

                        // Reset form
                        form[0].reset();
                        $('#form-create-error-summary').html('');
                        clearFieldErrors();
                    } else {
                        // Show error toast with detailed message
                        let errorMessage = response.message;
                        if (response.errors && response.errors.length > 0) {
                            ToastHelper.error(response.errors.join('\n'));
                            displayFieldErrors(response.errors);
                        } else {
                            ToastHelper.error(errorMessage);
                        }
                    }
                },
                error: function(xhr, status, error) {
                    let errorMessage = 'Terjadi kesalahan. Silakan coba lagi.';
                    try {
                        var response = JSON.parse(xhr.responseText);
                        if (response.message) {
                            errorMessage = response.message;
                        }
                        if (response.errors && response.errors.length > 0) {
                            errorMessage += '\n' + response.errors.join('\n');
                        }
                    } catch (e) {
                        // Response is not JSON
                        console.error('JSON Parse Error:', e);

                        // fallback plain text
                        if (xhr.responseText) {
                            errorMessage = xhr.responseText;
                        }
                    }
                    ToastHelper.error(errorMessage);
                    console.error('Error:', error);                    
                }
            });
        });
    });

    function clearFieldErrors() {
        $('#form-create-nas .text-danger').html('');
        $('#form-create-nas .form-control').removeClass('is-invalid');
        $('#form-create-nas .form-select').removeClass('is-invalid');
    }

    function displayFieldErrors(errors) {
            clearFieldErrors();

            errors.forEach(function(error) {
                const lowerError = error.toLowerCase();
                console.log(error);
                // Try to match error to field
                if (lowerError.includes('nas name')) {
                    $('#error-createNasName').html(error);
                    $('#createNasName').addClass('is-invalid');                    
                } else if (lowerError.includes('short name')) {
                    $('#error-createShortName').html(error);
                    $('#createShortName').addClass('is-invalid');
                } else if (lowerError.includes('type')) {
                    $('#error-createType').html(error);
                    $('#createType').addClass('is-invalid');
                } else if (lowerError.includes('port')) {
                    $('#error-createPorts').html(error);
                    $('#createPorts').addClass('is-invalid');
                } else if (lowerError.includes('secret')) {
                    $('#error-createSecret').html(error);
                    $('#createSecret').addClass('is-invalid');                    
                }  else if (lowerError.includes('server')) {
                    $('#error-createServer').html(error);
                    $('#createServer').addClass('is-invalid');
                } else if (lowerError.includes('community')) {
                    $('#error-createCommunity').html(error);
                    $('#createCommunity').addClass('is-invalid');
                } else if (lowerError.includes('description')) {
                    $('#error-createDescription').html(error);
                    $('#createDescription').addClass('is-invalid');
                }                 
            });
        }
    
</script>
