@{
    ViewData["Title"] = "Mikrotik RADIUS Accounting";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
}

@section VendorScripts {
    <script src="~/assets/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
}

@section PageScripts {
    <script>
        var dataTable;

        document.addEventListener('DOMContentLoaded', function() {
            dataTable = new DataTable(document.querySelector('#datatable'), {
                ajax: {
                    url: '@Url.Action("GetJsonResult", "MikrotikRadiusSession", new { area = "Administrator" })',
                    dataSrc: ''
                },
                layout: {
                    topStart: {
                        rowClass: 'row mx-3 my-0 justify-content-between',
                        features: [
                            {
                                pageLength: {
                                    menu: [7, 10, 25, 50, 100],
                                    text: 'Show_MENU_entries'
                                }
                            }
                        ]
                    },
                    topEnd: {
                        search: {
                            placeholder: 'Search accounting...'
                        }
                    },
                    bottomStart: {
                        rowClass: 'row mx-3 justify-content-between',
                        features: ['info']
                    },
                    bottomEnd: 'paging'
                },
                language: {
                    paginate: {
                        next: '<i class="icon-base ti tabler-chevron-right scaleX-n1-rtl icon-18px"></i>',
                        previous: '<i class="icon-base ti tabler-chevron-left scaleX-n1-rtl icon-18px"></i>',
                        first: '<i class="icon-base ti tabler-chevrons-left scaleX-n1-rtl icon-18px"></i>',
                        last: '<i class="icon-base ti tabler-chevrons-right scaleX-n1-rtl icon-18px"></i>'
                    }
                },
                columns: [
                    { data: 'id', title: 'ID' },
                    { data: 'username', title: 'Username' },
                    { data: 'nasIpAddress', title: 'NAS IP' },
                    { data: 'startTime', title: 'Start Time' },
                    { data: 'stopTime', title: 'Stop Time' },
                    { data: 'duration', title: 'Duration' },
                    { data: 'inputData', title: 'Input Data' },
                    { data: 'outputData', title: 'Output Data' },
                    { data: 'totalData', title: 'Total Data' },
                    { data: 'framedIp', title: 'Framed IP' },
                    {
                        data: 'id', title: 'Actions', orderable: false, render: function(data, type, row) {
                            return `<button class="btn btn-sm btn-info btn-detail-acct" data-id="${data}" style="margin-right: 5px;">Detail</button>`;
                        }
                    }
                ],
                responsive: true
            });

            window.dataTable = dataTable;

            // Handle Detail button click
            $(document).on('click', '.btn-detail-acct', function() {
                var acctId = $(this).data('id');
                window.location.href = '@Url.Action("Detail", "MikrotikRadiusSession", new { area = "Administrator" })?id=' + acctId;
            });

            // Handle Cleanup button
            $(document).on('click', '#btn-cleanup', function() {
                var days = prompt('Delete accounting records older than (days):', '30');
                if (days !== null) {
                    $.post('@Url.Action("DeleteOldSessions", "MikrotikRadiusSession", new { area = "Administrator" })', { days: days }, function(response) {
                        if (response.success) {
                            dataTable.ajax.reload();
                            alert(response.message);
                        } else {
                            alert('Error: ' + response.message);
                        }
                    });
                }
            });
        });
    </script>
}

<div class="container-xl">
    <!-- Page title -->
    <div class="page-header d-print-none">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title">
                    Mikrotik RADIUS Accounting
                </h2>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <div class="btn-list">
                    <button id="btn-cleanup" class="btn btn-warning">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M4 7l16 0" />
                            <path d="M10 11l0 6" />
                            <path d="M14 11l0 6" />
                            <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12" />
                            <path d="M9 7v-1a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v1" />
                        </svg>
                        Cleanup Old Records
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-wrapper">
    <!-- Page body -->
    <div class="page-body">
        <div class="container-xl">
            <div class="row row-deck row-cards">
                <div class="col-12">
                    <div class="card">
                        <div class="table-responsive">
                            <table id="datatable" class="table table-vcenter card-table"></table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
